# Copy to .env and fill in to run the company on real Claude.
# Without a key the company runs in deterministic SIMULATION mode (still fully functional).
ANTHROPIC_API_KEY=

# Model used by every agent. Defaults to Anthropic's most capable Opus-tier model.
COMPANY_MODEL=claude-opus-4-8

# Reasoning effort for agents: low | medium | high | xhigh | max
COMPANY_EFFORT=high

# Where the SQLite company state lives.
COMPANY_DB=company.db

# Set to 1 to force simulation mode even when a key is present (useful for demos/tests).
COMPANY_SIMULATE=0

# Spend budget (USD) before the company raises a budget alert.
COMPANY_BUDGET=25

# If set, state-changing API calls require this token (Authorization: Bearer <token>).
# Leave empty for open local use.
COMPANY_API_TOKEN=
